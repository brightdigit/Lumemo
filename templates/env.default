# From part-3-fastlane.md ".env files (companion)" — adapted to iOS for Lumemo.
#
# NOTE: this file would normally be named `.env.default` so fastlane auto-loads
# it on every invocation. It is named `env.default` here (no leading dot) so
# attendees can see it in the workshop repo. Rename to `.env.default` when
# copying into your own project.
#
# Committed; non-secret defaults. Identity (APP_IDENTIFIER, APPLE_ID, TEAM_ID,
# ITC_TEAM_ID) lives in Appfile, not here. Don't duplicate.

# Required: app name (xcodebuild scheme + ASC display name)
APP_NAME=Lumemo

# Required: platform configuration — change both together
PLATFORM=ios
PRODUCE_PLATFORM=ios

# Required: TestFlight changelog text
BETA_CHANGELOG=New features and bug fixes.

# Optional (Fastfile has fallbacks)
# APP_STORE_APP_ID=         # populated after `setup_app` registers the app
# BETA_APP_DESCRIPTION=     # defaults to APP_NAME
# BETA_FEEDBACK_EMAIL=      # defaults to APPLE_ID from Appfile

# Secrets live in a separate file — see `env` (which would be `.env` in
# your own project, gitignored). Don't add MATCH_PASSWORD or the
# APP_STORE_CONNECT_API_KEY_* values here.
